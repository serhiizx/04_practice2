# Скопіювати у .env і підставити власні ключи.
OPENAI_API_KEY=sk-...

# Провайдер обирається цими двома змінними, код чіпати не треба.
# Справжній OpenAI (використовується для демо-прогонів і трейсів):
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Локальний LM Studio — розкоментувати натомість
# (OPENAI_API_KEY тоді може бути будь-яким непорожнім рядком):
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=google/gemma-4-e4b

# Langfuse Cloud — ключи з project settings на https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
